# -----------------------------------
# Server Configuration
# -----------------------------------
# Bind to loopback only. Never expose this API to the public internet.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8786

# -----------------------------------
# Authentication Configuration
# -----------------------------------
AUTH_INITIAL_EMAIL=admin@example.com
AUTH_INITIAL_PASSWORD=change-this-password
# Generate with: openssl rand -base64 48
AUTH_JWT_SECRET=change-this-to-any-random-text
AUTH_TOKEN_TTL_MINUTES=60

# -----------------------------------
# Database Configuration
# -----------------------------------
# sqlite (default)
DATABASE_TYPE=sqlite
DATABASE_URI=file:dbdata/wppserver.db?_pragma=foreign_keys(1)
# postgres
#DATABASE_TYPE=postgres
#DATABASE_URI=host=localhost port=5432 user=postgres password=root dbname=wppserver sslmode=disable

# -----------------------------------
# SSL/TLS Certificate
# -----------------------------------
#CERTIFICATE_FILE=/path/to/your_domain_name.crt
#CERTIFICATE_KEY_FILE=/path/to/your_private.key

# -----------------------------------
# Purchase key License
# -----------------------------------
# LICENSE_KEY is kept for upstream compatibility. It is not validated by
# this fork and has no effect.
LICENSE_KEY=XXXX-XXXX-XXXXX-XXXX

# -----------------------------------
# API Settings
# -----------------------------------
# New users created by an admin are disabled unless this is ENABLED.
NEW_USERS_STATUS=DISABLED
# Public self-registration is disabled. Admins can still create users.
ALLOW_USER_REGISTRATION=false

# -----------------------------------
# Logging
# -----------------------------------
# DEBUG, INFO, WARN or ERROR. Keep INFO in production.
WHATSAPP_LOG_LEVEL=INFO
